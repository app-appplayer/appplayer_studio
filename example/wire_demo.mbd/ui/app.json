{
  "type": "page",
  "title": "Wire Demo",
  "state": {
    "input": "",
    "shouted": ""
  },
  "content": {
    "type": "linear",
    "padding": 16,
    "children": [
      {
        "type": "text",
        "value": "Wire Demo — minimal tool↔UI sample",
        "style": {
          "fontSize": 18,
          "fontWeight": "bold"
        }
      },
      {
        "type": "textInput",
        "label": "Text to shout",
        "value": "{{input}}",
        "onChanged": {
          "action": "state",
          "binding": "input",
          "value": "{{event.value}}"
        }
      },
      {
        "type": "button",
        "label": "Shout",
        "onTap": {
          "action": "tool",
          "tool": "wire_demo.shout",
          "args": {
            "text": "{{input}}"
          }
        }
      },
      {
        "type": "text",
        "value": "Result: {{shouted}}"
      }
    ],
    "direction": "vertical"
  }
}