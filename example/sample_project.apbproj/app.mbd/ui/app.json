{
  "type": "page",
  "title": "Sample App",
  "state": {
    "counter": 0
  },
  "content": {
    "type": "linear",
    "padding": 24,
    "mainAxisAlignment": "center",
    "crossAxisAlignment": "center",
    "children": [
      {
        "type": "text",
        "value": "Sample App",
        "style": {
          "fontSize": 24,
          "fontWeight": "bold"
        }
      },
      {
        "type": "text",
        "value": "Counter: {{counter}}"
      },
      {
        "type": "linear",
        "mainAxisAlignment": "center",
        "children": [
          {
            "type": "button",
            "label": "−",
            "onTap": {
              "action": "state",
              "binding": "counter",
              "value": "{{counter - 1}}"
            }
          },
          {
            "type": "sizedBox",
            "width": 8
          },
          {
            "type": "button",
            "label": "+",
            "onTap": {
              "action": "state",
              "binding": "counter",
              "value": "{{counter + 1}}"
            }
          }
        ],
        "direction": "horizontal"
      }
    ],
    "direction": "vertical"
  }
}